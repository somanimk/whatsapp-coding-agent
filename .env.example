WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Meta app Settings > Basic > App secret (not the verify token)
WHATSAPP_APP_SECRET=
# Select a supported version from your Meta dashboard.
WHATSAPP_API_VERSION=v25.0

# Keep false until storage, workflow, and worker secrets are configured.
AUTOMATION_ENABLED=false
# Your personal WhatsApp number in international digits, no '+' (comma-separated allowed).
WHATSAPP_ALLOWED_SENDERS=
DATABASE_URL=
# Fine-grained GitHub token: target repo Contents/PRs write, Deployments/Checks read;
# service repo Actions write. Model never receives this token.
GITHUB_AUTOMATION_TOKEN=
GITHUB_WORKER_REPO=somanimk/whatsapp-coding-agent
GITHUB_WORKER_REF=phase1-webhook
# Worker only. Choose a Responses API model supporting structured outputs.
OPENAI_API_KEY=
OPENAI_MODEL=
